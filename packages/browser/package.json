{
  "name": "@vue-godot/browser",
  "version": "0.0.1",
  "description": "Browser API polyfills for GodotJS (fetch, URL, Blob, atob/btoa, TextEncoder, etc.)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot.git",
    "directory": "packages/browser"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js",
      "default": "./dist/globals.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "vue",
    "godot",
    "browser",
    "polyfill",
    "fetch"
  ],
  "author": "Portwatcher",
  "license": "MIT",
  "dependencies": {
    "@vue-godot/device": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
