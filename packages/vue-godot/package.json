{
  "name": "vue-godot",
  "version": "0.0.3",
  "description": "Unscoped npx alias for the Vue Godot CLI",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot.git",
    "directory": "packages/vue-godot"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "vue-godot": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc -p . && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build"
  },
  "dependencies": {
    "@vue-godot/cli": "^0.0.3"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "keywords": [
    "vue",
    "godot",
    "cli",
    "npx"
  ],
  "author": "Portwatcher",
  "license": "MIT"
}
