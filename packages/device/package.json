{
  "name": "@vue-godot/device",
  "version": "0.0.1",
  "description": "Device and native capability adapters for Vue Godot",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot.git",
    "directory": "packages/device"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js",
      "default": "./dist/clipboard.js"
    },
    "./haptics": {
      "types": "./dist/haptics.d.ts",
      "import": "./dist/haptics.js",
      "default": "./dist/haptics.js"
    },
    "./microphone": {
      "types": "./dist/microphone.d.ts",
      "import": "./dist/microphone.js",
      "default": "./dist/microphone.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js",
      "default": "./dist/permissions.js"
    },
    "./sensors": {
      "types": "./dist/sensors.d.ts",
      "import": "./dist/sensors.js",
      "default": "./dist/sensors.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "vue",
    "godot",
    "device",
    "native",
    "capabilities"
  ],
  "author": "Portwatcher",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
