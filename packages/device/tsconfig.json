{
  "compilerOptions": {
    "target": "es2016",
    "module": "ESNext",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"],
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "newLine": "crlf",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
