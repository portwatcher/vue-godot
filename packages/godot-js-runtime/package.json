{
  "name": "godot-js-runtime",
  "version": "0.0.0-development",
  "description": "Standalone JavaScript and TypeScript runtime for official Godot",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot.git",
    "directory": "packages/godot-js-runtime"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./installer": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js",
      "default": "./dist/install.js"
    }
  },
  "bin": {
    "godot-js-runtime": "dist/cli.js"
  },
  "files": [
    "addon/godot-js-runtime/godot_js_runtime.gdextension",
    "addon/godot-js-runtime/runtime-manifest.json",
    "dist",
    "native/SConstruct",
    "native/deps.lock.json",
    "native/godot-cpp-profile.json",
    "native/godot_js_runtime.gdextension.in",
    "native/generated",
    "native/include",
    "native/src/**/*.cpp",
    "native/tests/**/*.cpp",
    "native/tests/fixtures",
    "scripts",
    "typings",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc -p .",
    "test": "npm run build && npm run check:types && npm run test:types && node --test test/*.test.mjs",
    "bootstrap:native": "node scripts/bootstrap-deps.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node scripts/build-native.mjs --run-tests",
    "generate:bindings": "node scripts/generate-bindings.mjs",
    "check:bindings": "node scripts/generate-bindings.mjs --check",
    "gen:types": "node scripts/generate-types.mjs",
    "generate:types": "npm run gen:types",
    "check:types": "node scripts/generate-types.mjs --check",
    "test:types": "tsc -p test/fixtures/plain-types",
    "generate:manifest": "node scripts/generate-extension-manifest.mjs",
    "smoke:native": "node scripts/smoke-stock-godot.mjs"
  },
  "keywords": [
    "godot",
    "javascript",
    "typescript",
    "gdextension",
    "quickjs"
  ],
  "author": "Portwatcher",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
