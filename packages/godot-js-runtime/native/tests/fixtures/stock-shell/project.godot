config_version=5

[application]

config/name="Godot JavaScript Runtime stock shell smoke"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[native_extensions]

paths=["res://addons/godot-js-runtime/godot_js_runtime.gdextension"]

[editor_plugins]

enabled=PackedStringArray("res://addons/editor-play-loop/plugin.cfg")

[editor]

run/main_run_args="--headless"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[godot_js_runtime]

runtime/memory_limit_mb=96
runtime/maximum_stack_size_kb=768
runtime/interrupt_interval_milliseconds=2
runtime/execution_timeout_milliseconds=4000
runtime/maximum_promise_jobs_per_frame=12000
