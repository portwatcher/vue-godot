{
  "schemaVersion": 1,
  "format": "commonjs",
  "entryFile": "app.js",
  "externalModules": ["godot"],
  "requiredFiles": [
    "app.js",
    "app.js.map",
    "chunks/chunk.js",
    "chunks/chunk.js.map"
  ],
  "forbiddenFilePatterns": ["-[A-Za-z0-9_-]{8,}\\.js(?:\\.map)?$"],
  "entryPatterns": [
    {
      "description": "deterministic CommonJS bundle metadata",
      "source": "^\\\"use strict\\\";\\n/\\*! godot-js-runtime:format=commonjs \\*/"
    },
    {
      "description": "external godot CommonJS require",
      "source": "require\\([\\\"']godot[\\\"']\\)"
    },
    {
      "description": "relative CommonJS chunk require",
      "source": "require\\([\\\"']\\./chunks/chunk\\.js[\\\"']\\)"
    },
    {
      "description": "default script export",
      "source": "exports\\.default\\s*="
    }
  ],
  "missingRuntimePatterns": [
    "No loader found for resource",
    "Failed loading resource",
    "Failed to load script",
    "Cannot load source code"
  ]
}
