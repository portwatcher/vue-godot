{
  "name": "vue-godot",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-godot-scan-ignores.mjs",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@vue-godot/cli",
    "build:runtime": "turbo run build --filter=@vue-godot/runtime-tscn",
    "build:godotjs": "npm run build:native --workspace=packages/godot-js-runtime",
    "package:godotjs": "npm run package:release --workspace=packages/godot-js-runtime",
    "generate:export-presets": "node packages/godot-js-runtime/scripts/export-presets.mjs",
    "build:godotjs-demo": "npm run build --workspace=godotjs-demo",
    "gen:types": "npm run gen:types --workspace=packages/godot-js-runtime",
    "check:vue-types": "vue-tsc --noEmit -p apps/html-demo/vue/tsconfig.json",
    "build:demo": "turbo run build --filter=\"./apps/*\"",
    "test": "turbo run test --filter=\"./packages/*\" && npm run test:scripts",
    "test:scripts": "node --test test/*.test.mjs",
    "test:godotjs": "npm run test --workspace=packages/godot-js-runtime",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke:public-cli": "node scripts/smoke-public-cli.mjs",
    "smoke:godot": "node scripts/smoke-godot.mjs",
    "smoke:generated-godot": "node scripts/smoke-generated-godot.mjs",
    "smoke:editor-reload": "node scripts/smoke-editor-reload.mjs",
    "build:runtime-contract-fixture": "node scripts/runtime-contract-fixture.mjs --build",
    "smoke:runtime-contract": "node scripts/smoke-runtime-contract.mjs",
    "smoke:godotjs": "node packages/godot-js-runtime/scripts/smoke-stock-godot.mjs",
    "smoke:platform-exports": "node packages/godot-js-runtime/scripts/smoke-platform-exports.mjs",
    "smoke:godotjs-demo": "node packages/godot-js-runtime/scripts/smoke-standalone-demo.mjs",
    "setup:godot": "node scripts/setup-godot.mjs",
    "setup:godot-templates": "node scripts/setup-godot-export-templates.mjs",
    "bench:performance": "npm run bench:performance:deterministic && npm run bench:performance:godot",
    "bench:performance:deterministic": "node scripts/performance-benchmarks.mjs",
    "bench:performance:godot": "node scripts/performance-godot.mjs",
    "check:serious-examples": "node scripts/check-serious-example-apps.mjs",
    "check:public-surface": "node scripts/public-surface-audit.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "check": "npm run build && npm run test && npm run smoke:cli && npm run check:serious-examples && npm run bench:performance",
    "vue-godot": "vue-godot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2",
    "vue": "^3.5.29",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "portwatcher",
    "url": "https://juryquinn.com"
  },
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
