{
  "name": "vue-godot",
  "scripts": {
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@vue-godot/cli",
    "build:runtime": "turbo run build --filter=@vue-godot/runtime-tscn",
    "build:demo": "turbo run build --filter=\"./apps/*\"",
    "test": "turbo run test --filter=\"./packages/*\" && npm run test:scripts",
    "test:scripts": "node --test test/*.test.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke:public-cli": "node scripts/smoke-public-cli.mjs",
    "smoke:godot": "node scripts/smoke-godot.mjs",
    "smoke:generated-godot": "node scripts/smoke-generated-godot.mjs",
    "smoke:editor-reload": "node scripts/smoke-editor-reload.mjs",
    "setup:godotjs": "node scripts/setup-godotjs.mjs",
    "bench:performance": "node scripts/performance-benchmarks.mjs",
    "check:serious-examples": "node scripts/check-serious-example-apps.mjs",
    "check:public-surface": "node scripts/public-surface-audit.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "check": "npm run build && npm run test && npm run smoke:cli && npm run check:serious-examples && npm run bench:performance",
    "vue-godot": "vue-godot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portwatcher/vue-godot"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "portwatcher",
    "url": "https://juryquinn.com"
  },
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
