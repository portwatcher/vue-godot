{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "vue": ["../../../node_modules/@vue/runtime-core/dist/runtime-core.d.ts"],
      "godot": ["../typings/godot.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../typings/**/*.d.ts"]
}
