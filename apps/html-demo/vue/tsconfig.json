{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "vue": ["../../../node_modules/@vue/runtime-core/dist/runtime-core.d.ts"],
      "godot": ["../../../packages/godot-js-runtime/typings/godot.d.ts"]
    }
  },
  "vueCompilerOptions": {
    "plugins": ["@vue-godot/html/volar-plugin"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../typings/**/*.d.ts"]
}
